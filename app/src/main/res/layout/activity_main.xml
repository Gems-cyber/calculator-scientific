<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp"
        tools:context=".activities.MainActivity">

        <!-- ================= DISPLAY ================= -->

        <!-- ================= DISPLAY ================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/display_background"
            android:elevation="8dp"
            android:gravity="bottom"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="18dp"
            android:paddingEnd="24dp"
            android:paddingBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:animateLayoutChanges="true"
                    android:text="Scientific Calculator"
                    android:textColor="#B0BEC5"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtAngleMode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DEG"
                    android:textColor="#64B5F6"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <TextView
                android:id="@+id/txtExpression"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="start"
                android:gravity="end"
                android:maxLines="1"
                android:text=""
                android:textColor="#9E9E9E"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/txtDisplay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:ellipsize="start"
                android:gravity="end"
                android:letterSpacing="0.03"
                android:maxLines="1"
                android:scrollHorizontally="true"
                android:text="0"
                android:textColor="#FFFFFF"
                android:textSize="48sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="Functions"
            android:textColor="#8A8A8A"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- ============ SCIENTIFIC ROW 1 ============ -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSin"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:background="@drawable/button_scientific"
                android:backgroundTint="@null"
                android:maxLines="1"
                android:singleLine="true"
                android:text="sin"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                app:backgroundTint="@null" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnCos"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:background="@drawable/button_scientific"
                android:backgroundTint="@null"
                android:maxLines="1"
                android:singleLine="true"
                android:text="cos"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                app:backgroundTint="@null" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnTan"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:background="@drawable/button_scientific"
                android:backgroundTint="@null"
                android:maxLines="1"
                android:singleLine="true"
                android:text="tan"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                app:backgroundTint="@null" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnLog"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_margin="2dp"
                android:layout_weight="1"
                android:background="@drawable/button_scientific"
                android:backgroundTint="@null"
                android:maxLines="1"
                android:singleLine="true"
                android:text="log"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                app:backgroundTint="@null" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnLn"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:background="@drawable/button_scientific"
                android:backgroundTint="@null"
                android:maxLines="1"
                android:singleLine="true"
                android:text="ln"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                app:backgroundTint="@null" />

        </LinearLayout>

        <!-- ============ SCIENTIFIC ROW 2 ============ -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSqrt"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:background="@drawable/button_scientific"
                android:backgroundTint="@null"
                android:text="√"
                android:textColor="@android:color/white"
                app:backgroundTint="@null" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSquare"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:background="@drawable/button_scientific"
                android:backgroundTint="@null"
                android:text="x²"
                android:textColor="@android:color/white"
                app:backgroundTint="@null" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnPower"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:background="@drawable/button_scientific"
                android:backgroundTint="@null"
                android:text="xʸ"
                android:textColor="@android:color/white"
                app:backgroundTint="@null" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnPi"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:background="@drawable/button_scientific"
                android:backgroundTint="@null"
                android:text="π"
                android:textColor="@android:color/white"
                app:backgroundTint="@null" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnE"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:background="@drawable/button_scientific"
                android:backgroundTint="@null"
                android:text="e"
                android:textColor="@android:color/white"
                app:backgroundTint="@null" />

        </LinearLayout>
        <!-- THIRD SCIENTIFIC ROW -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnReciprocal"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:background="@drawable/button_scientific"
                android:backgroundTint="@null"
                android:text="1/x"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                app:backgroundTint="@null" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnFactorial"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:background="@drawable/button_scientific"
                android:backgroundTint="@null"
                android:text="n!"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                app:backgroundTint="@null" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnOpenBracket"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:background="@drawable/button_scientific"
                android:backgroundTint="@null"
                android:text="("
                android:textColor="@android:color/white"
                app:backgroundTint="@null" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnCloseBracket"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:background="@drawable/button_scientific"
                android:backgroundTint="@null"
                android:text=")"
                android:textColor="@android:color/white"
                app:backgroundTint="@null" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnDegRad"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:background="@drawable/button_control"
                android:text="DEG"
                android:textColor="@android:color/white"
                android:textStyle="bold" />
        </LinearLayout>
        <!-- CONTROL ROW -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnClear"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:background="@drawable/button_control"
                android:text="C"
                android:textColor="@android:color/white" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnDelete"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:background="@drawable/button_control"
                android:maxLines="1"
                android:singleLine="true"
                android:text="DEL"
                android:textColor="@android:color/white"
                android:textSize="11sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnPlusMinus"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:background="@drawable/button_control"
                android:text="±"
                android:textColor="@android:color/white" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnDivide"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:background="@drawable/button_operator_new"
                android:text="÷"
                android:textColor="@android:color/white" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp"
            android:background="#2A2A2A" />
        <!-- NUMBER ROW 1 -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:orientation="horizontal">


            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn7"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:background="@drawable/button_number"
                android:text="7"
                android:textColor="@android:color/white"
                android:textSize="22sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn8"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:background="@drawable/button_number"
                android:text="8"
                android:textColor="@android:color/white"
                android:textSize="22sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn9"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:background="@drawable/button_number"
                android:text="9"
                android:textColor="@android:color/white"
                android:textSize="22sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnMultiply"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:background="@drawable/button_operator_new"
                android:text="×"
                android:textColor="@android:color/white"
                android:textSize="26sp"
                android:textStyle="bold" />

        </LinearLayout>
        <!-- NUMBER ROW 2 -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn4"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:background="@drawable/button_number"
                android:text="4"
                android:textColor="@android:color/white"
                android:textSize="22sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn5"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:background="@drawable/button_number"
                android:text="5"
                android:textColor="@android:color/white"
                android:textSize="22sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn6"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:background="@drawable/button_number"
                android:text="6"
                android:textColor="@android:color/white"
                android:textSize="22sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnMinus"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:background="@drawable/button_operator_new"
                android:text="−"
                android:textColor="@android:color/white"
                android:textSize="26sp"
                android:textStyle="bold" />

        </LinearLayout>
        <!-- NUMBER ROW 3 -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn1"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:background="@drawable/button_number"
                android:text="1"
                android:textColor="@android:color/white"
                android:textSize="22sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn2"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:background="@drawable/button_number"
                android:text="2"
                android:textColor="@android:color/white"
                android:textSize="22sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn3"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:background="@drawable/button_number"
                android:text="3"
                android:textColor="@android:color/white"
                android:textSize="22sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnPlus"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:background="@drawable/button_operator_new"
                android:text="+"
                android:textColor="@android:color/white"
                android:textSize="26sp"
                android:textStyle="bold" />

        </LinearLayout>
        <!-- NUMBER ROW 4 -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn0"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_margin="4dp"
                android:layout_weight="2"
                android:background="@drawable/button_number"
                android:text="0"
                android:textColor="@android:color/white"
                android:textSize="22sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnDecimal"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_margin="4dp"
                android:layout_weight="1"
                android:background="@drawable/button_number"
                android:text="."
                android:textColor="@android:color/white"
                android:textSize="22sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnEquals"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_margin="4dp"
                android:layout_weight="1.3"
                android:background="@drawable/button_operator_new"
                android:text="="
                android:textColor="@android:color/white"
                android:textSize="26sp"
                android:textStyle="bold" />

        </LinearLayout>
    </LinearLayout>
</LinearLayout>

